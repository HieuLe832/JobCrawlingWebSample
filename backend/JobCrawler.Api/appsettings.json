{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=jobs.db"
  },
  "Crawler": {
    "UserAgentToken": "JobCrawlerBot",
    "UserAgent": "Mozilla/5.0 (compatible; JobCrawlerBot/0.1; +https://example.com/bot)",
    "DelayMs": 1500,
    "TimeoutSeconds": 30
  }
}
